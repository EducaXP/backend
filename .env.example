HOST=127.0.0.1
PORT=3333
DATABASE_URL=postgresql://educaxp:troque-esta-senha@localhost:5432/educaxp
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_HOURS=12
ENABLE_DOCS=true
NODE_ENV=development

# Assistente opcional. Configure somente no backend/Coolify (variáveis de execução).
# Sem chave, o modelo local e o editor continuam disponíveis.
AI_PROVIDER=openrouter
AI_MODEL=
AI_API_KEY=
# URL base, sem /chat/completions. Para outro serviço use AI_PROVIDER=compatible.
AI_BASE_URL=https://openrouter.ai/api/v1
